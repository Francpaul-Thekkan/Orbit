{
  "name": "orbit",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Offline-first AI account and usage manager",
  "author": "Orbit",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "esbuild scripts/native-bridge.js --bundle --format=esm --outfile=dist/native.js --minify",
    "test:ui": "node scripts/qa.mjs",
    "test:desktop": "node scripts/desktop-qa.mjs",
    "test:sync-ui": "node scripts/sync-qa.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "pack:win": "electron-builder --win portable nsis --x64",
    "pack:mac": "electron-builder --mac dmg",
    "mobile:android": "cap sync android",
    "mobile:ios": "cap sync ios"
  },
  "build": {
    "appId": "app.orbit.accounts",
    "productName": "Orbit",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "START-HERE.md",
        "to": "START-HERE.md"
      },
      {
        "from": "GOOGLE-SYNC-SETUP.md",
        "to": "GOOGLE-SYNC-SETUP.md"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "dist/icon-512.png",
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "artifactName": "Orbit-Beta-v1-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Orbit-v1.0.0-beta-win-x64-setup.exe"
    },
    "portable": {
      "artifactName": "Orbit-v1.0.0-beta-win-x64-portable.exe"
    },
    "buildVersion": "1.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3"
  },
  "license": "UNLICENSED",
  "keywords": [
    "ai",
    "usage-tracker",
    "subscription-manager",
    "offline-first",
    "pwa",
    "electron",
    "capacitor"
  ]
}
